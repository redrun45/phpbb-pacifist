{
    "name": "redrun45/pacifist",
    "type": "phpbb-extension",
    "description": "Removes the 'sid=' parameter from generated links.  Guests that do not use cookies (mostly bots) will no longer be tracked.",
    "homepage": "https://github.com/redrun45/phpbb-pacifist",
    "version": "1.0.0-dev",
    "time": "2025-06-20",
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "redrun45",
            "email": "",
            "homepage": "https://github.com/redrun45",
            "role": "First user"
        }
    ],
    "require": {
        "php": ">=7.1.3",
        "composer/installers": "~1.0"
    },
    "extra": {
      "display-name": "Pacifist Bot Mitigations",
      "soft-require": {
          "phpbb/phpbb": ">=3.3.0,<4.0.0@dev"
      }
    }
}
